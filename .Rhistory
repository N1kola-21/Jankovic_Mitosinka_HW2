title: "Data Analysis in R"
# What we will cover
- Basic data types and how R stores values
> **Theme for today**
# From objects to data
Last week we created objects such as a single value and a vector:
```{r}
prices_step1 <- raw_prices |>
mutate(
# first we check if it is YMD
is_ymd = str_detect(date, "^[0-9]{4}[./-]"),
# we assume the other cases are DMY
clean_date = case_when(
is_ymd ~ ymd(date),
!is_ymd ~ dmy(date),
TRUE ~ NA_Date_
)
)
library(tidyverse)
prices_step1 <- raw_prices |>
mutate(
# first we check if it is YMD
is_ymd = str_detect(date, "^[0-9]{4}[./-]"),
# we assume the other cases are DMY
clean_date = case_when(
is_ymd ~ ymd(date),
!is_ymd ~ dmy(date),
TRUE ~ NA_Date_
)
)
sum(is.na(prices_step1$clean_date))
class(prices_step1$clean_date)
prices_step1$clean_date
prices_step1 <- raw_prices |>
mutate(
# first we check if it is YMD
is_ymd = str_detect(date, "^[0-9]{4}[./-]"),
# we assume the other cases are DMY
clean_date = case_when(
is_ymd ~ ymd(date),
!is_ymd ~ dmy(date),
TRUE ~ NA_Date_
)
)
#Part 2
#2.1 Dates, prices and identifiers
#firstly we fix dates
prices_step1 <- raw_prices |>
mutate(trade_date_raw = date)
# Vytvoříme logický vektor, který říká, kde datum začíná 2 číslicemi (tedy dnem)
is_dmy <- !is.na(prices_step1$trade_date_raw) &
str_detect(prices_step1$trade_date_raw, "^[0-9]{2}[./-]")
# Vytvoříme prázdný sloupec pro čisté datumy typu Date
prices_step1$clean_date <- as.Date(rep(NA_character_, nrow(prices_step1)))
# Nyní aplikujeme dmy() POUZE na ty řádky, které jsou DMY, a ymd() na zbytek.
# Protože funkce "nevidí" formáty, kterým nerozumí, nehodí žádné varování.
prices_step1$clean_date[is_dmy] <- dmy(prices_step1$trade_date_raw[is_dmy])
prices_step1$clean_date[!is_dmy] <- ymd(prices_step1$trade_date_raw[!is_dmy])
# Kontrola, zda nám něco nezůstalo nepřevedené
sum(is.na(prices_step1$clean_date))
prices_step1 <- raw_prices |>
mutate(
# first we check if it is YMD
is_ymd = str_detect(date, "^[0-9]{4}[./-]"),
# we assume the other cases are DMY
clean_date = case_when(
is_ymd ~ ymd(date),
!is_ymd ~ dmy(date),
TRUE ~ NA_Date_
)
)
sum(is.na(prices_step1$clean_date))
class(prices_step1$clean_date)
prices_step1$clean_date
#We get a warning that some data failed to parse however when looking at the observations in the enviroment the number remains the same. We check that
prices_step1$date[is.na(prices_step1$clean_date)]
